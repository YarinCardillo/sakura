# Shipped profile for the confinement self-tests (tests/confinement.sh). It becomes the project
# "selftest" only when something names it (box new <task> selftest). Its source repository is a
# local throwaway clone in the data directory, so that `box take` can run for real without touching
# any other repository. Create the clone with: git clone <repo> "$AGENTBOX_HOME/selftest-source"
# (the data directory of this box, $AGENTBOX_HOME unless AGENTBOX_HOME says otherwise).
# @AGENTBOX_HOME@ is replaced with the data directory when the profile becomes a project.
# The clone needs a branch main with a package.json and a package-lock.json at its root.
REPO=@AGENTBOX_HOME@/selftest-source
BASE=main
INSTALL=true
VERB_poison=echo pwned > node_modules/poison-marker && echo poison-written
VERB_probe=test ! -e node_modules/poison-marker && echo pristine
# Jobs that try to choose what the runner records about them (tests/confinement.sh): one prints
# look-alike records and leaves a record file, one kills the wrapper that started it, one leaves
# a process behind that would run for ten minutes.
VERB_forge=printf 'seconds=999999\npeak_bytes=1\n' > /tmp/.box-job-meta; echo BOX_VERB_SECONDS=999999; echo BOX_PEAK_BYTES=1; sleep 12
VERB_killwrapper=sleep 3; kill -9 $(ps -o ppid= -p $PPID)
VERB_linger=(sleep 600 >/dev/null 2>&1 &); sleep 3
WHERE=box
