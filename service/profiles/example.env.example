# An example of a project file. box does not read this file: a project is made with
#   box project add <name> --repo <path> [options]
# or proposed from a folder with
#   box project detect <path> --json
# and lives in $AGENTBOX_HOME/projects/<name>.env. The lines below show what such a file holds.
# Plain KEY=value lines; nothing is evaluated.
#
# The repository on this machine, the branch new work starts from, and the folder of the project
# inside the repository (empty for the root).
REPO=/path/to/your/repository
BASE=main
SUBDIR=apps/web
# Where a new lavoro lives unless box new says otherwise: mac (a worktree, the agent runs as
# you) or box (a confined container).
WHERE=mac
# How the dependencies are installed, and the checks the runner can be requested (box verify).
INSTALL=npm ci
VERB_test=npm test
VERB_build=npm run build
# Files that define the checks, as globs (* inside a name, ** across folders). A commit that
# changes one of them is reported as changesChecks. A commit that changes anything outside
# SUBDIR is reported too, unless SAFE_OUTSIDE lists the path.
PROTECTED=package.json package-lock.json tsconfig*.json eslint.config.* scripts/**
SAFE_OUTSIDE=README.md docs/**
# Test files: existing ones that a commit modifies or deletes are reported as testsTouched.
TEST_FILES=**/*.spec.ts
