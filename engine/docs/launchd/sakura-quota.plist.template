<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>local.sakura.quota</string>
    <key>ProgramArguments</key>
    <array>
        <string>__SAKURA_BIN__</string>
        <string>quota</string>
        <string>serve</string>
        <string>--refresh-minutes</string>
        <string>10</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>30</integer>
    <key>EnvironmentVariables</key>
    <dict>
        <key>HOME</key>
        <string>__HOME__</string>
        <key>PATH</key>
        <string>__HOME__/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    </dict>
    <key>StandardOutPath</key>
    <string>__HOME__/.local/state/sakura/quota-service.log</string>
    <key>StandardErrorPath</key>
    <string>__HOME__/.local/state/sakura/quota-service.log</string>
</dict>
</plist>
