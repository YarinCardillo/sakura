@@ -0,0 +1,14 @@
+import { useLibraryItems } from "@/lib/catalogs/query";
+
+type Props = { onPick: (id: string) => void };
+
+export function ItemPicker({ onPick }: Props) {
+  const items = useLibraryItems({ scope: "all", kind: "video" });
+  return (
+    <ul className="picker">
+      {items.map((item) => (
+        <li key={item.id} onClick={() => onPick(item.id)}>{item.title}</li>
+      ))}
+    </ul>
+  );
+}
